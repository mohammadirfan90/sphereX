<?xml version="1.0" encoding="UTF-8"?>
<VOTABLE xmlns="http://www.ivoa.net/xml/VOTable/v1.3" version="1.3">
  <RESOURCE type="results">
    <TABLE>
      <FIELD name="access_url" datatype="char" arraysize="*" ucd="access.url"/>
      <FIELD name="obs_id" datatype="char" arraysize="*" ucd="meta.id"/>
      <FIELD name="s_ra" datatype="double" ucd="pos.eq.ra;meta.main" unit="deg"/>
      <FIELD name="s_dec" datatype="double" ucd="pos.eq.dec;meta.main" unit="deg"/>
      <FIELD name="dataproduct_type" datatype="char" arraysize="*"/>
    </TABLE>
    <INFO name="QUERY_STATUS" value="OK">no rows</INFO>
  </RESOURCE>
</VOTABLE>
